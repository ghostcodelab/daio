# Copy to .env and fill in. Never commit .env.

# RPC endpoints
ARBITRUM_SEPOLIA_RPC_URL=
ROBINHOOD_TESTNET_RPC_URL=

# Etherscan / explorer (V2 unified key — works across all chains)
# Get one at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Deployer
DEPLOYER_PRIVATE_KEY=

# Agent wallets (one private key per agent if running both locally)
MACRO_AGENT_PRIVATE_KEY=
CREDIT_AGENT_PRIVATE_KEY=

# LLM gateway. Routes through OpenRouter by default (multi-model router;
# get a key at https://openrouter.ai/keys). Agent code is model-agnostic.
LLM_API_KEY=
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# Optional base URL override for non-OpenRouter providers that speak the
# OpenAI-compatible wire format, e.g.
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_BASE_URL=

# Deployed addresses (filled after script/Deploy.s.sol runs).
# The Python agents and the frontend read from these.
USDC_ADDRESS=
AGENT_REGISTRY_ADDRESS=
DAIO_VAULT_ADDRESS=
PROPOSAL_ROUND_ADDRESS=
CONSENSUS_ADDRESS=
ALLOCATION_EXECUTOR_ADDRESS=
PERFORMANCE_FEE_ADDRESS=
SLASHING_ADDRESS=

# RWA basket tokens (the three mock RWAs the deploy script creates).
MUSDY_ADDRESS=
MIB01_ADDRESS=
MAAPL_ADDRESS=
