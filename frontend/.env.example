# Copy to frontend/.env.local and fill in. Never commit .env.local.
# These VITE_* vars are baked into the build at compile time and shipped
# to the browser, so do not put anything secret here.

# Public RPC URL for Arbitrum Sepolia. Falls back to the public endpoint
# if unset, but a private one (Alchemy / Infura) is recommended for demos.
VITE_ARBITRUM_SEPOLIA_RPC_URL=

# WalletConnect Cloud project ID. Required for the CONNECT button to work
# on devices without an injected wallet (mobile, browsers without MetaMask).
# Sign up free at https://cloud.reown.com -> create project -> copy ID.
# If unset, the button falls back to redirecting to metamask.io/download.
VITE_WALLETCONNECT_PROJECT_ID=
